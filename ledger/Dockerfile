FROM eclipse-temurin:21-jre-alpine

ARG JAR_PATH=./server/target
ARG JAR_NAME=server
ARG JAR_VERSION=1.0.0-SNAPSHOT
ARG TARGET_PATH=/app

ENV APPLICATION=${TARGET_PATH}/ledger.jar
ENV LEDGER_HOST=0.0.0.0
ENV LEDGER_PORT=8090
ENV LEDGER_PROFILES=postgresql
ENV LEDGER_DATABASE_HOST=localhost
ENV LEDGER_DATABASE_PORT=5432
ENV LEDGER_DATABASE_DB=ledger
ENV LEDGER_DATABASE_USERNAME=ledger
ENV LEDGER_DATABASE_PASSWORD=ledger
ENV LEDGER_CHECKPOINT_INTERVAL=1m

ADD ${JAR_PATH}/${JAR_NAME}-${JAR_VERSION}-exec.jar ${TARGET_PATH}/ledger.jar

EXPOSE ${LEDGER_PORT}
HEALTHCHECK --interval=10s --timeout=3s --retries=30 CMD wget -qO- http://localhost:${LEDGER_PORT}/actuator/health || exit 1
ENTRYPOINT java -jar ${APPLICATION}
