<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.nexusphere</groupId>
        <artifactId>nexusphere</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>core</artifactId>
    <packaging>pom</packaging>
    <name>Nexusphere Core</name>

    <!-- Ordered by dependency direction; see docs/architecture/module-dependencies.md. -->
    <modules>
        <module>shared</module>
        <module>network</module>
        <module>organization</module>
        <module>identity</module>
        <module>membership</module>
        <module>authorization</module>
        <module>trust</module>
        <module>federation</module>
        <module>delegation</module>
        <module>capability</module>
        <module>discovery</module>
        <module>agreement</module>
        <module>transaction</module>
        <module>audit</module>
        <module>integration</module>
        <module>bootstrap</module>
        <module>e2e-tests</module>
    </modules>

    <properties>
        <spring-boot.version>4.1.1</spring-boot.version>
        <spring-modulith.version>2.1.1</spring-modulith.version>
        <springdoc-openapi.version>3.1.1</springdoc-openapi.version>
        <archunit.version>1.5.1</archunit.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.modulith</groupId>
                <artifactId>spring-modulith-bom</artifactId>
                <version>${spring-modulith.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc-openapi.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
            </dependency>

            <!-- Core modules -->
            <dependency><groupId>com.nexusphere</groupId><artifactId>shared</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>com.nexusphere</groupId><artifactId>network</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>com.nexusphere</groupId><artifactId>organization</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>com.nexusphere</groupId><artifactId>identity</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>com.nexusphere</groupId><artifactId>membership</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>com.nexusphere</groupId><artifactId>authorization</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>com.nexusphere</groupId><artifactId>trust</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>com.nexusphere</groupId><artifactId>federation</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>com.nexusphere</groupId><artifactId>delegation</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>com.nexusphere</groupId><artifactId>capability</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>com.nexusphere</groupId><artifactId>discovery</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>com.nexusphere</groupId><artifactId>agreement</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>com.nexusphere</groupId><artifactId>transaction</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>com.nexusphere</groupId><artifactId>audit</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>com.nexusphere</groupId><artifactId>integration</artifactId><version>${project.version}</version></dependency>
            <dependency><groupId>com.nexusphere</groupId><artifactId>bootstrap</artifactId><version>${project.version}</version></dependency>
        </dependencies>
    </dependencyManagement>

    <!-- Every module gets plain unit-test support; Spring is added only where a module needs it. -->
    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                    <executions>
                        <execution>
                            <id>repackage</id>
                            <goals>
                                <goal>repackage</goal>
                            </goals>
                            <configuration>
                                <!-- Keep the plain jar as the main artifact so tests can depend on it. -->
                                <classifier>exec</classifier>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
